# VITA production settings - TEMPLATE (Task 20). NO SECRETS IN THIS FILE.
#
# setup.sh copies this file to ./.env (permissions 600), fills the empty secret lines with values generated
# by `openssl rand -hex 32` and sets SITE_ADDRESS. Never commit .env, never paste its contents into a chat,
# an e-mail or a ticket. To change a setting later: edit .env, then run `docker compose up -d`.
#
# The app refuses to start (it lists every problem, never the values) when a required setting is missing,
# too short, still a placeholder, or unsafe - see trust-crm/utils/preflight.js.
#
# Lines starting with "# KEY=" are optional and OFF; remove the "# " to use them.

# ------------------------------------------------------------------ server address (HTTPS by Caddy)
# The public host name Caddy gets a certificate for. First run without a domain: setup.sh uses
# <your-server-ip-with-dashes>.sslip.io (a free third-party DNS service, e.g. 203-0-113-10.sslip.io).
# Later, your own domain: point an A record at the server IP, put the name here, run `docker compose up -d`.
SITE_ADDRESS=
# Optional: e-mail for the certificate authority account (expiry notices). Plain address only.
# ACME_EMAIL=
# Optional: Caddy's request body limit; keep it a little above MAX_UPLOAD_MB (default 12MB).
# CADDY_MAX_BODY=12MB

# ------------------------------------------------------------------ deployment mode (written by setup.sh - do not edit)
# Fixed Docker Compose project name: containers/volumes/network are vita-* / vita_*, so they can never mix with
# another Docker project on the server. Never run `docker compose down -v` from another folder.
# COMPOSE_PROJECT_NAME=vita
# Default (Caddy) mode:  COMPOSE_PROFILES=caddy
# ./setup.sh --behind-nginx writes instead (Caddy off, app published only on 127.0.0.1):
# VITA_DEPLOY_MODE=nginx
# COMPOSE_FILE=docker-compose.yml:docker-compose.nginx.yml
# VITA_APP_PORT=8083
# VITA_WWW=1
# In nginx mode SITE_ADDRESS (above) is only informational (links); the certificate is managed by certbot/nginx.

# ------------------------------------------------------------------ runtime
# Always production on a server ("test" is for the test suite only). docker-compose.yml enforces it.
NODE_ENV=production
# Caddy is the one proxy hop in front of the app: needed so per-IP rate limits see the real client address.
TRUST_PROXY=1
# Lifetime of staff sessions (seconds or 30m / 12h / 7d)
JWT_EXPIRES_IN=12h
# Max milliseconds to finish work on `docker compose stop` (the container gets 30 s)
SHUTDOWN_TIMEOUT_MS=25000
# Staff sign-in rate limits per app process (15-minute windows): failures per e-mail / per IP, attempts per IP
# LOGIN_EMAIL_FAILURES=5
# LOGIN_IP_FAILURES=10
# LOGIN_IP_ATTEMPTS=100

# ------------------------------------------------------------------ secrets (generated by setup.sh)
# Signs login sessions. At least 32 characters, random (openssl rand -hex 32). Changing it logs everyone out.
JWT_SECRET=
# Signs short-lived download links for uploaded files. At least 32 random characters, different from JWT_SECRET.
STORAGE_URL_SECRET=
# Signs the [VITA-...] reply tokens put in application e-mails. At least 32 random characters.
JOBSEARCH_REPLY_SECRET=

# ------------------------------------------------------------------ database (the "db" container)
# docker-compose.yml always connects the app to the "db" container on port 5432.
# DB_USER is an UNPRIVILEGED role (no superuser/createdb/createrole) that owns the database; it is created
# when the database volume is first initialised (db-init/10-app-role.sh). The Postgres SUPERUSER password is
# generated by setup.sh into a separate file, .env.db (POSTGRES_USER / POSTGRES_PASSWORD, permissions 600),
# which only the db container reads; backup.sh / restore.sh use it inside the db container.
DB_HOST=db
DB_PORT=5432
DB_USER=vita_app
DB_NAME=vita
# Generated by setup.sh. Only used inside the Docker network (the database is not reachable from the internet).
# Changing it later requires changing it in Postgres too - leave it as generated.
DB_PASSWORD=

# ------------------------------------------------------------------ file storage (the "app-storage" volume)
# Fixed by docker-compose.yml (/data/storage inside the container). Max upload size in MB.
STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=10

# ------------------------------------------------------------------ mail: SAFE SANDBOX by default
# sandbox = NO real e-mail ever leaves the server. Only recipients on MAIL_SANDBOX_ALLOWLIST are accepted and
# stored in the database (js_sandbox_mail; read them with ./show-sandbox-mail.sh); mail to anyone else is
# refused and NOT stored - so real candidates cannot receive sign-in codes until real mail is set up. Switch to real mail only after reading
# docs/vita-job-search/SETUP.md (section "Real e-mail") and setting every MAIL_SMTP_* value below.
MAIL_PROVIDER=sandbox
# Must be exactly true - lower case - (with MAIL_PROVIDER=imap_smtp and complete SMTP settings) for real sending.
MAIL_REAL_SEND=false
# Sandbox only: which recipients the sandbox accepts (comma list, * wildcards). To try the candidate sign-in
# yourself, add your own test address, e.g. *@test.invalid,you@your-domain.com (its codes then appear in
# ./show-sandbox-mail.sh - they are still NOT delivered to the mailbox).
MAIL_SANDBOX_ALLOWLIST=*@test.invalid
# Plain sender address of YOUR domain (jobs@your-domain.com). Optional in sandbox mode (vita@test.invalid is
# used), REQUIRED for real mail.
# MAIL_FROM=
# Reply-To mailbox (plain address); defaults to MAIL_FROM
# MAIL_REPLY_TO=
# Real mail only (e.g. Hostinger e-mail: smtp.hostinger.com, port 465 or 587)
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=

# ------------------------------------------------------------------ CV attachments / malware scanning
# No ClamAV in this kit: uploaded CVs are marked scan_unavailable.
# true is allowed ONLY because mail is in sandbox mode (nothing reaches an employer). Set it to false
# before enabling real mail (MAIL_REAL_SEND=true) unless you configure ClamAV below - the server refuses to
# start with real mail + unscanned attachments + no ClamAV.
ALLOW_UNSCANNED_ATTACHMENTS=true
# clamd host/port (INSTREAM over TCP), e.g. a "clamav/clamav" container on the backend network
# CLAMAV_HOST=
# CLAMAV_PORT=3310

# ------------------------------------------------------------------ replies (inbound mail webhook)
# HMAC secret for POST /jobsearch/inbound/mail. Unset = webhook disabled (answers 503): no employer replies
# are received. Set it (openssl rand -hex 32) only when you connect a forwarding bridge (SETUP.md).
# INBOUND_MAIL_SECRET=
# Replies without DKIM/DMARC results are never matched automatically (keep true).
INBOUND_AUTH_REQUIRED=true
# Acknowledgement evidence needs a staff click (keep false; true is risk-accepting).
INBOUND_AUTO_ACK_EVIDENCE=false

# ------------------------------------------------------------------ job sources: nothing is fetched until set
# Every source stays "requires_setup" until configured (SOURCES_AND_PROVIDERS.md). https only.
# JOBBANK_CA_FEED_URL=
# PARTNER_FEED_URLS=

# ------------------------------------------------------------------ background work
# Scheduler: every minute; only "connected" sources run, so with no source configured it finds nothing.
JOBSEARCH_SCHEDULER=on
# Queue workers (searches, sends). Sends still need consent, approval, caps > 0 and real mail.
JOBSEARCH_WORKERS=on

# ------------------------------------------------------------------ public website (served at the domain root)
# Every fact below is OPTIONAL and hidden on the website until you set it: nothing is invented. Docs:
# docs/vita-website-crm/SETUP.md. (SITE_ADDRESS above is the server host name, not the postal address.)
# Generated by setup.sh (openssl rand -hex 32). Salts the one-way hashes used for the public-form rate limits.
# Changing it only resets those limits. If it is empty the app logs a warning and uses an insecure built-in salt.
SITE_IP_SALT=
# SITE_NAME=VITA
# SITE_PHONE=
# Full https link, e.g. https://wa.me/21612345678
# SITE_WHATSAPP=
# SITE_EMAIL=
# The company's postal address shown on the website (reaches the app as SITE_ADDRESS, see docker-compose.yml)
# SITE_POSTAL_ADDRESS=
# Licence wording exactly as issued; leave empty until you have it
# SITE_LICENCE_TEXT=
# https://your-domain (no trailing slash). Needed for the absolute URLs in /sitemap.xml and /robots.txt
# SITE_BASE_URL=
# Public lead form limits: submissions per IP per hour (default 5), per e-mail/phone per day (default 3)
# SITE_LEAD_IP_PER_HOUR=5
# SITE_LEAD_EMAIL_PER_DAY=3
# Global cap on all public lead submissions per day (honeypot hits included); over it the form answers 429. Default 2000.
# SITE_LEAD_GLOBAL_PER_DAY=2000
# Version label of the consent wording stored with each lead; change it when the wording changes
# SITE_CONSENT_VERSION=2026-10-v1
# Employer / agency portals: recruitment requests one employer can send per day (default 20)
# EMPLOYER_REQUESTS_PER_DAY=20
# Candidates one agency can register per day (default 50)
# AGENCY_CANDIDATES_PER_DAY=50
# Accounting (optional; see docs/vita-accounting/SETUP.md). Currencies staff may use, comma separated (default TND,EUR,CAD,USD)
# FIN_CURRENCIES=TND,EUR,CAD,USD
# One flat tax rate in percent applied to new invoices; leave empty for no tax
# FIN_TAX_RATE_PERCENT=
# Invoice / receipt header facts (owner inputs, hidden when empty)
# FIN_COMPANY_NAME=
# FIN_COMPANY_ADDRESS=
# FIN_COMPANY_TAX_ID=
# Row cap per CSV export (default and maximum 50000)
# FIN_EXPORT_MAX_ROWS=50000

# Attendance and HR (clock in/out, leave, approvals, reports)
# Company timezone for clock times, "today", late and absent (IANA name)
# HR_TIMEZONE=Africa/Tunis
# A clock-in left open longer than this many hours (1-168) is flagged "needs correction", never closed automatically
# HR_MAX_OPEN_HOURS=16
# Row cap per attendance CSV export (default and maximum 50000)
# HR_EXPORT_MAX_ROWS=50000

# Messaging (optional; see docs/vita-messaging/SETUP.md). Text messages between staff and candidates, employers and agencies
# Messages one user can send per minute across all conversations (default 30); above it the API answers 429
# CHAT_RATE_PER_MIN=30
# May a candidate start a conversation with their own staff? (default true; false = staff must open it first)
# CHAT_CANDIDATE_CAN_START=true
# Minutes between two e-mail nudges ("you have a new message", no content) per conversation and person (default 15; 0 = every message)
# CHAT_NUDGE_COOLDOWN_MIN=15
# Minutes a failed e-mail nudge keeps the person's cooldown slot held before a later message retries (0 = retry at once).
# CHAT_NUDGE_FAILURE_BACKOFF_MIN=5
# Live-event (SSE) streams: per user (default 5), in total (default 500), heartbeat in milliseconds (default 25000)
# CHAT_SSE_MAX_PER_USER=5
# CHAT_SSE_MAX_TOTAL=500
# CHAT_SSE_HEARTBEAT_MS=25000
# How long a stream's positive account check is reused when events are delivered (the heartbeat always re-checks).
# CHAT_SSE_RECHECK_MS=5000
# WhatsApp is NOT implemented: it needs your WhatsApp Business provider account and approved templates. Whatever you set here,
# the channel reports "requires setup" and nothing is sent.
# WHATSAPP_PROVIDER=
# SITE_BASE_URL (above) is also used for the link in the e-mail nudge; without it the nudge has no link.

# Assistant access / MCP server (optional; see docs/vita-mcp/SETUP.md). Read-only tools for Claude Desktop / Claude Code, OFF by default.
# Nothing under /mcp answers (404) until this is exactly "true"; token management in the staff console works either way.
# MCP_ENABLED=false
# Calls one token may make per minute (default 60, in this process only: resets on restart)
# MCP_RATE_PER_MIN=60
# Requests handled at the same time across all tokens (default 8); above it the server answers 503
# MCP_MAX_CONCURRENT=8
# Concurrent requests one token may hold (default 2); above it the server answers 429
# MCP_MAX_CONCURRENT_PER_TOKEN=2
# Time a client has to send the whole request body in milliseconds (default 5000); a stalled body is cut with 408 and frees its slot
# MCP_BODY_TIMEOUT_MS=5000
# Calls one USER may make per minute across all of his tokens (default 120)
# MCP_USER_RATE_PER_MIN=120
# Failed authentications per minute from one client address before it is refused with 429 without any lookup (default 30).
# Needs TRUST_PROXY=1 behind Caddy, otherwise every client shares the proxy's address.
# MCP_AUTH_FAIL_PER_MIN=30
# Overall deadline for one request in milliseconds (default 15000); above it the server answers 504
# MCP_REQUEST_TIMEOUT_MS=15000
# Deadline for one tool in milliseconds (default 10000); a slower tool returns an error result
# MCP_TOOL_TIMEOUT_MS=10000
# Default lifetime of a new token in days when the creator does not choose one (1-90, default 30)
# MCP_TOKEN_DEFAULT_DAYS=30
