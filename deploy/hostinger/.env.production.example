# VITA production settings - TEMPLATE (Task 20). NO SECRETS IN THIS FILE.
#
# setup.sh copies this file to ./.env (permissions 600), fills the empty secret lines with values generated
# by `openssl rand -hex 32` and sets SITE_ADDRESS. Never commit .env, never paste its contents into a chat,
# an e-mail or a ticket. To change a setting later: edit .env, then run `docker compose up -d`.
#
# The app refuses to start (it lists every problem, never the values) when a required setting is missing,
# too short, still a placeholder, or unsafe - see trust-crm/utils/preflight.js.
#
# Lines starting with "# KEY=" are optional and OFF; remove the "# " to use them.

# ------------------------------------------------------------------ server address (HTTPS by Caddy)
# The public host name Caddy gets a certificate for. First run without a domain: setup.sh uses
# <your-server-ip-with-dashes>.sslip.io (a free third-party DNS service, e.g. 203-0-113-10.sslip.io).
# Later, your own domain: point an A record at the server IP, put the name here, run `docker compose up -d`.
SITE_ADDRESS=

# ------------------------------------------------------------------ runtime
# Always production on a server ("test" is for the test suite only). docker-compose.yml enforces it.
NODE_ENV=production
# Caddy is the one proxy hop in front of the app: needed so per-IP rate limits see the real client address.
TRUST_PROXY=1
# Lifetime of staff sessions (seconds or 30m / 12h / 7d)
JWT_EXPIRES_IN=12h
# Max milliseconds to finish work on `docker compose stop` (the container gets 30 s)
SHUTDOWN_TIMEOUT_MS=25000

# ------------------------------------------------------------------ secrets (generated by setup.sh)
# Signs login sessions. At least 32 characters, random (openssl rand -hex 32). Changing it logs everyone out.
JWT_SECRET=
# Signs short-lived download links for uploaded files. At least 32 random characters, different from JWT_SECRET.
STORAGE_URL_SECRET=
# Signs the [VITA-...] reply tokens put in application e-mails. At least 32 random characters.
JOBSEARCH_REPLY_SECRET=

# ------------------------------------------------------------------ database (the "db" container)
# docker-compose.yml always connects the app to the "db" container on port 5432.
DB_HOST=db
DB_PORT=5432
DB_USER=vita
DB_NAME=vita
# Generated by setup.sh. Only used inside the Docker network (the database is not reachable from the internet).
# Changing it later requires changing it in Postgres too - leave it as generated.
DB_PASSWORD=

# ------------------------------------------------------------------ file storage (the "app-storage" volume)
# Fixed by docker-compose.yml (/data/storage inside the container). Max upload size in MB.
STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=10

# ------------------------------------------------------------------ mail: SAFE SANDBOX by default
# sandbox = NO real e-mail ever leaves the server; messages are stored in the database (js_sandbox_mail) and
# only recipients on MAIL_SANDBOX_ALLOWLIST are accepted. Switch to real mail only after reading
# docs/vita-job-search/SETUP.md (section "Real e-mail") and setting every MAIL_SMTP_* value below.
MAIL_PROVIDER=sandbox
# Must be exactly true (with MAIL_PROVIDER=imap_smtp and complete SMTP settings) for real sending.
MAIL_REAL_SEND=false
# Sandbox only: which recipients the sandbox accepts (comma list, * wildcards)
MAIL_SANDBOX_ALLOWLIST=*@test.invalid
# Plain sender address of YOUR domain (jobs@your-domain.com). Optional in sandbox mode (vita@test.invalid is
# used), REQUIRED for real mail.
# MAIL_FROM=
# Reply-To mailbox (plain address); defaults to MAIL_FROM
# MAIL_REPLY_TO=
# Real mail only (e.g. Hostinger e-mail: smtp.hostinger.com, port 465 or 587)
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=

# ------------------------------------------------------------------ CV attachments / malware scanning
# No ClamAV in this kit: uploaded CVs are marked scan_unavailable.
# true is allowed ONLY because mail is in sandbox mode (nothing reaches an employer). Set it to false
# before enabling real mail (MAIL_REAL_SEND=true) unless you configure ClamAV below - the server refuses to
# start with real mail + unscanned attachments + no ClamAV.
ALLOW_UNSCANNED_ATTACHMENTS=true
# clamd host/port (INSTREAM over TCP), e.g. a "clamav/clamav" container on the backend network
# CLAMAV_HOST=
# CLAMAV_PORT=3310

# ------------------------------------------------------------------ replies (inbound mail webhook)
# HMAC secret for POST /jobsearch/inbound/mail. Unset = webhook disabled (answers 503): no employer replies
# are received. Set it (openssl rand -hex 32) only when you connect a forwarding bridge (SETUP.md).
# INBOUND_MAIL_SECRET=
# Replies without DKIM/DMARC results are never matched automatically (keep true).
INBOUND_AUTH_REQUIRED=true
# Acknowledgement evidence needs a staff click (keep false; true is risk-accepting).
INBOUND_AUTO_ACK_EVIDENCE=false

# ------------------------------------------------------------------ job sources: nothing is fetched until set
# Every source stays "requires_setup" until configured (SOURCES_AND_PROVIDERS.md). https only.
# JOBBANK_CA_FEED_URL=
# PARTNER_FEED_URLS=

# ------------------------------------------------------------------ background work
# Scheduler: every minute; only "connected" sources run, so with no source configured it finds nothing.
JOBSEARCH_SCHEDULER=on
# Queue workers (searches, sends). Sends still need consent, approval, caps > 0 and real mail.
JOBSEARCH_WORKERS=on
