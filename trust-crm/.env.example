PORT=5000
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trustcrm
DB_PORT=5432
JWT_SECRET=replace_with_secure_random_secret

# Optional: single connection string (overrides DB_* when set)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/trustcrm
# Used by tests (takes precedence over DATABASE_URL)
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/trustcrm_test

# --- VITA job search: storage ---
# Required outside NODE_ENV=test; signs short-lived download URLs (use a long random value)
STORAGE_URL_SECRET=
# Private upload directory (default: trust-crm/.storage, git-ignored)
# STORAGE_DIR=.storage
# Max upload size in MB (default 10)
# MAX_UPLOAD_MB=10

# --- VITA job search: mail ---
# sandbox (default; records to DB, allow-listed recipients only) | imap_smtp
# MAIL_PROVIDER=sandbox
# Comma list; "*" wildcards allowed (default *@test.invalid)
# MAIL_SANDBOX_ALLOWLIST=*@test.invalid
# MAIL_FROM=
# Real sending only happens with imap_smtp AND MAIL_REAL_SEND=true
# MAIL_REAL_SEND=false
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=
# MAIL_IMAP_HOST=
# MAIL_IMAP_USER=
# MAIL_IMAP_PASS=

# --- VITA job search: CV upload ---
# Malware scan: clamd (INSTREAM over TCP). Unset => scan status "scan_unavailable" (shown honestly).
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=10000
# Max CV uploads per user per hour (default 20)
# JS_UPLOADS_PER_HOUR=20
