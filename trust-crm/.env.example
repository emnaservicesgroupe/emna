PORT=5000
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trustcrm
DB_PORT=5432
JWT_SECRET=replace_with_secure_random_secret

# Optional: single connection string (overrides DB_* when set)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/trustcrm
# Used by tests (takes precedence over DATABASE_URL)
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/trustcrm_test

# --- VITA job search: storage ---
# Required outside NODE_ENV=test; signs short-lived download URLs (use a long random value)
STORAGE_URL_SECRET=
# Private upload directory (default: trust-crm/.storage, git-ignored)
# STORAGE_DIR=.storage
# Max upload size in MB (default 10)
# MAX_UPLOAD_MB=10

# --- VITA job search: mail ---
# sandbox (default; records to DB, allow-listed recipients only) | imap_smtp
# MAIL_PROVIDER=sandbox
# Comma list; "*" wildcards allowed (default *@test.invalid)
# MAIL_SANDBOX_ALLOWLIST=*@test.invalid
# MAIL_FROM=
# Real sending only happens with imap_smtp AND MAIL_REAL_SEND=true
# MAIL_REAL_SEND=false
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=
# MAIL_IMAP_HOST=
# MAIL_IMAP_USER=
# MAIL_IMAP_PASS=

# --- VITA job search: CV upload ---
# Malware scan: clamd (INSTREAM over TCP). Unset => scan status "scan_unavailable" (shown honestly).
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=10000
# Max CV uploads per user per hour (default 20)
# JS_UPLOADS_PER_HOUR=20

# --- VITA job search: sources (nothing is fetched until these are set; sources stay "requires_setup") ---
# Authorized official Job Bank (Canada) feed URL. https only; private/loopback hosts are refused.
# JOBBANK_CA_FEED_URL=
# Comma list of approved partner feed URLs (JSON or RSS), https only
# PARTNER_FEED_URLS=
# Identifying User-Agent sent to feeds (default: VITA-JobSearch/1.0 ...)
# JOBSEARCH_USER_AGENT=

# Matching: matches scoring below this (0-100) are not stored (default 40)
# MATCH_MIN_SCORE=40

# --- VITA job search: submissions (Task 11) ---
# HMAC secret for the reply token [VITA-...] put in subjects / Reply-To (falls back to JWT_SECRET)
# JOBSEARCH_REPLY_SECRET=
# Reply-To mailbox for employer replies (plus-addressed with the token; falls back to MAIL_FROM)
# MAIL_REPLY_TO=
# Queue workers (started from server.js by Task 12): "off" disables them; never run when NODE_ENV=test
# JOBSEARCH_WORKERS=on
# JOBSEARCH_WORKER_INTERVAL_MS=30000
# Job-search scheduler (Task 12): ticks every minute (single process via a Postgres session advisory
# lock - needs session pooling, not PgBouncer transaction pooling). "off" disables it; never runs when NODE_ENV=test.
# Per-source schedules come from js_sources.schedule_cron (5-field cron, UTC; default "0 */6 * * *").
# JOBSEARCH_SCHEDULER=on
# APPLICATIONS_PER_TICK=5            new applications per candidate per tick
# MATCH_AUTO_PREPARE_MIN=60          minimum match score for the scheduler to create/prepare an application
# JOB_RECHECK_HOURS=24               open jobs not checked for this long are re-checked (bounded batch)
# SCHEDULER_QUEUE_BATCH=50           max queue items processed per drain
# SCHEDULER_RECHECK_BATCH=20         max jobs re-checked per tick
# SCHEDULER_CANDIDATES_PER_TICK=200  max candidates searched/matched per tick
# SCHEDULER_RETRY_BATCH=20           max deferred/held applications retried per tick
# SCHEDULER_REFUSAL_BACKOFF_HOURS=6  refused automatic approvals/queues are retried after this (minimum 6)
# NOTE: cap_per_day / cap_per_week default to 0 = no sends at all until an admin sets them > 0.

# --- VITA job search: replies / inbox (Task 13) ---
# Inbound mail webhook POST /jobsearch/inbound/mail (Hostinger/Gmail forwarding bridge, SendGrid/Mailgun
# inbound parse...). The pusher signs the RAW JSON body: header X-VITA-Signature: sha256=<hex HMAC-SHA256>.
# Unset = webhook disabled (503). IMAP polling is not implemented in this build (imap_smtp reports requires_setup).
# INBOUND_MAIL_SECRET=
# Max webhook body size in bytes (default 1 MB) and requests per minute per IP (default 120)
# INBOUND_MAIL_MAX_BYTES=1048576
# INBOUND_MAIL_RATE_PER_MIN=120
# User id (active Admin/SuperAdmin/Manager) who receives 'unmatched_reply' review tasks (default: first active Admin)
# JOBSEARCH_INBOX_REVIEWER_ID=
