PORT=5000
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trustcrm
DB_PORT=5432
JWT_SECRET=replace_with_secure_random_secret
# Lifetime of staff tokens from /auth/login: seconds or a number with s/m/h/d (e.g. 12h, 7d). Default 12h.
# Staff tokens carry token_version (tv): suspending a user ends their sessions on the next request.
# JWT_EXPIRES_IN=12h
# Set to production on a real server. "test" is reserved for the test suite: it enables the test_fixture
# job source, disables the scheduler/workers and relaxes secret checks - never use it on a real server.
# NODE_ENV=production
# Behind an HTTPS reverse proxy: number of proxy hops to trust (usually 1) or an address list such as
# "loopback". Needed so per-IP rate limits (OTP, inbound webhook) see the client IP. "true" is refused.
# Unset = Express default (socket peer address).
# TRUST_PROXY=1

# Optional: single connection string (overrides DB_* when set)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/trustcrm
# Used by tests (takes precedence over DATABASE_URL)
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/trustcrm_test

# --- VITA job search: storage ---
# Required outside NODE_ENV=test; signs short-lived download URLs (use a long random value)
STORAGE_URL_SECRET=
# Private upload directory (default: trust-crm/.storage, git-ignored)
# STORAGE_DIR=.storage
# Max upload size in MB (default 10)
# MAX_UPLOAD_MB=10

# --- VITA job search: mail ---
# sandbox (default; records to DB, allow-listed recipients only) | imap_smtp
# MAIL_PROVIDER=sandbox
# Comma list; "*" wildcards allowed (default *@test.invalid)
# MAIL_SANDBOX_ALLOWLIST=*@test.invalid
# REQUIRED for any send outside tests (Task 19): a plain address of your domain, e.g. jobs@your-domain.example
# (no display name / list / line breaks). Used for From, Reply-To and the Message-ID domain. No fallback.
# MAIL_FROM=
# Real sending only happens with imap_smtp AND MAIL_REAL_SEND=true
# MAIL_REAL_SEND=false
# MAIL_SMTP_HOST=
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=
# Not used (IMAP polling is not implemented; replies arrive through the inbound webhook). Sending does not need them.
# MAIL_IMAP_HOST=
# MAIL_IMAP_USER=
# MAIL_IMAP_PASS=

# --- VITA job search: CV upload ---
# Malware scan: clamd (INSTREAM over TCP). Unset => scan status "scan_unavailable" (shown honestly).
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=10000
# Unscanned CVs (scan_status scan_unavailable) are NOT attached to applications unless this is exactly "true"
# (preparation/approval/pre-send stop with attachment_unscanned). Infected files are always blocked.
# ALLOW_UNSCANNED_ATTACHMENTS=false
# Max CV uploads per user per hour (default 20)
# JS_UPLOADS_PER_HOUR=20
# CV text extraction runs in a worker thread: hard timeout in ms (default 10000) and the maximum total
# uncompressed size of a DOCX in MB (default 50; zip-bomb guard)
# EXTRACT_TIMEOUT_MS=10000
# MAX_UNCOMPRESSED_MB=50
# Test-suite only (ignored unless NODE_ENV=test): artificial extraction delay
# EXTRACT_TEST_DELAY_MS=

# --- VITA job search: sources (nothing is fetched until these are set; sources stay "requires_setup") ---
# Authorized official Job Bank (Canada) feed URL. https only; private/loopback hosts are refused.
# JOBBANK_CA_FEED_URL=
# Comma list of approved partner feed URLs (JSON or RSS), https only
# PARTNER_FEED_URLS=
# Identifying User-Agent sent to feeds (default: VITA-JobSearch/1.0 ...)
# JOBSEARCH_USER_AGENT=

# Matching: matches scoring below this (0-100) are not stored (default 40)
# MATCH_MIN_SCORE=40

# --- VITA job search: submissions (Task 11) ---
# HMAC secret for the reply token [VITA-...] put in subjects / Reply-To (falls back to JWT_SECRET)
# JOBSEARCH_REPLY_SECRET=
# Reply-To mailbox for employer replies (plain address; plus-addressed with the token; falls back to MAIL_FROM)
# MAIL_REPLY_TO=
# Queue workers (started from server.js by Task 12): "off" disables them; never run when NODE_ENV=test
# JOBSEARCH_WORKERS=on
# JOBSEARCH_WORKER_INTERVAL_MS=30000
# Job-search scheduler (Task 12): ticks every minute (single process via a Postgres session advisory
# lock - needs session pooling, not PgBouncer transaction pooling). "off" disables it; never runs when NODE_ENV=test.
# Per-source schedules come from js_sources.schedule_cron (5-field cron, UTC; default "0 */6 * * *").
# JOBSEARCH_SCHEDULER=on
# APPLICATIONS_PER_TICK=5            new applications per candidate per tick
# MATCH_AUTO_PREPARE_MIN=60          minimum match score for the scheduler to create/prepare an application
# JOB_RECHECK_HOURS=24               open jobs not checked for this long are re-checked (bounded batch)
# SCHEDULER_QUEUE_BATCH=50           max queue items processed per drain
# SCHEDULER_RECHECK_BATCH=20         max jobs re-checked per tick
# SCHEDULER_CANDIDATES_PER_TICK=200  max candidates searched/matched per tick
# SCHEDULER_RETRY_BATCH=20           max deferred/held applications retried per tick
# SCHEDULER_REFUSAL_BACKOFF_HOURS=6  refused automatic approvals/queues are retried after this (minimum 6)
# NOTE: cap_per_day / cap_per_week default to 0 = no sends at all until an admin sets them > 0.

# --- VITA job search: replies / inbox (Task 13) ---
# Inbound mail webhook POST /jobsearch/inbound/mail (Hostinger/Gmail forwarding bridge, SendGrid/Mailgun
# inbound parse...). The pusher signs the RAW JSON body: header X-VITA-Signature: sha256=<hex HMAC-SHA256>.
# Unset = webhook disabled (503). IMAP polling is not implemented in this build (imap_smtp reports requires_setup).
# INBOUND_MAIL_SECRET=
# Max webhook body size in bytes (default 1 MB) and requests per minute per IP (default 120)
# INBOUND_MAIL_MAX_BYTES=1048576
# INBOUND_MAIL_RATE_PER_MIN=120
# User id (active Admin/SuperAdmin/Manager) who receives 'unmatched_reply' review tasks (default: first active Admin)
# JOBSEARCH_INBOX_REVIEWER_ID=
# Inbound authentication results (DKIM/DMARC) pushed in the payload field `authResults` (string header
# value | array of header values | {dkim, spf, dmarc, dkimDomain?}). Any dkim/dmarc fail|permerror|temperror
# -> never matched. true (default in production) = a message WITHOUT auth results is never matched
# automatically (review queue). Employer-acknowledgement evidence always needs an aligned dkim=pass.
# INBOUND_AUTH_REQUIRED=true
# TRUST: only your OWN receiving MTA's Authentication-Results count - the bridge must strip any
# sender-supplied Authentication-Results headers. Optional: when set, only results whose authserv-id
# (first token of the header value, e.g. "mx.vita.example") equals this value are considered.
# INBOUND_AUTHSERV_ID=
# Bounces (DSN) open a staff 'verify_delivery' task only when they come from MAILER-DAEMON/postmaster at
# one of these domains (comma list; MAIL_FROM's domain always included) or are multipart/report
# delivery-status. A bounce never changes a submission/application status.
# INBOUND_BOUNCE_DOMAINS=
# Acknowledgement evidence requires staff confirmation by default. Inbound employer mail is UNTRUSTED:
# with false (the default in EVERY environment, production included) a matched, authenticated reply that
# looks like an acknowledgement only opens a 'confirm_acknowledgement' staff task; a manager confirms it
# (POST /jobsearch/messages/:id/confirm-acknowledgement) before the submission becomes confirmed_submitted.
# WARNING: true = record employer_acknowledgement evidence automatically from the reply text. Use only if
# you accept the classifier's residual false-accept risk (a cleverly worded rejection could be counted as an
# acknowledgement). Only the value true (any case) enables it.
INBOUND_AUTO_ACK_EVIDENCE=false

# --- Dashboard / reports / exports / realtime events (Task 14) ---
# CSV export (GET /jobsearch/export.csv): max rows per file (cap 10000; a '# truncated' first line marks a
# capped file) and exports per user per hour (in-memory, per process; 429 + Retry-After beyond it).
# JOBSEARCH_EXPORT_MAX_ROWS=10000
# JOBSEARCH_EXPORT_RATE_PER_HOUR=10
# SSE (GET /jobsearch/events): shared DB poll interval, per-stream scope re-check interval (reassignment,
# suspension, token revocation take effect within it), heartbeat comment interval, connection caps.
# JOBSEARCH_SSE_POLL_MS=2000
# JOBSEARCH_SSE_RECHECK_MS=60000
# JOBSEARCH_SSE_HEARTBEAT_MS=25000
# JOBSEARCH_SSE_MAX_PER_USER=3
# JOBSEARCH_SSE_MAX_TOTAL=500
# SSE: a stream whose unsent buffer exceeds this many bytes (stalled reader) is closed; rows per poll.
# JOBSEARCH_SSE_MAX_BUFFER_BYTES=262144
# JOBSEARCH_SSE_BATCH=500

# --- DEV ONLY: scripts/dev-seed-ui.js (demo data; NEVER run against a production database) ---
# The seed refuses NODE_ENV=production, non-local database hosts and databases that already hold real users.
# VITA_SEED_PASSWORD=          demo login password (>= 12 chars); unset = random, printed once
# VITA_SEED_ALLOW_REMOTE=      1 = allow a disposable remote dev database
# VITA_SEED_FORCE=             1 = seed even though non-demo users exist (dev databases only)
