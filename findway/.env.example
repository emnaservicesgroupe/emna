# FIND WAY — environment template. Copy to .env (never commit .env). No real secrets belong in this file.
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
DATABASE_URL=postgres://postgres@localhost:5432/findway

# REQUIRED in production: base64 of >=32 random bytes (e.g. `openssl rand -base64 48`). Derives the OTP, encryption,
# identity-hash and webhook-secret keys. Rotating it invalidates stored secrets: plan a re-encryption step first.
APP_MASTER_KEY=

SESSION_TTL_HOURS=12
TRUST_PROXY=false            # set true behind a reverse proxy so rate limits see the real client IP
WORKERS_ENABLED=true         # in-process delivery + job-expiry loops; disable if you run them from a scheduler

# Mail: 'dev' keeps messages in memory (development only). 'smtp' is a placeholder until credentials exist.
MAIL_PROVIDER=dev
MAIL_FROM=FIND WAY <no-reply@example.com>
DEV_MAIL_CAPTURE=true        # ignored in production

# trust-crm connection (service account must exist in trust-crm with candidates:read/write, visa:write)
TRUSTCRM_BASE_URL=
TRUSTCRM_SERVICE_EMAIL=
TRUSTCRM_SERVICE_PASSWORD=
TRUSTCRM_TIMEOUT_MS=8000

WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_ALLOWED_HOSTS=       # comma-separated hosts exempt from the private-address (SSRF) guard

# One-off CLI: scripts/create-super-admin.js
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
